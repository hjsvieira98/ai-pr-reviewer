+export async function loadOrders(
+  db: { query: (sql: string, params: string[]) => Promise<unknown[]> },
+  userIds: string[],
+) {
+  const orders = [];
+  for (const id of userIds) {
+    orders.push(await db.query("SELECT * FROM orders WHERE user_id = $1", [id]));
+  }
+  return orders;
+}
