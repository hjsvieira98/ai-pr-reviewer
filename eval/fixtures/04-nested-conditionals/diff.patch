+export function readSetting(input: { a?: { b?: { c?: { value?: string } } } } | null): string | null {
+  if (input) {
+    if (input.a) {
+      if (input.a.b) {
+        if (input.a.b.c) {
+          return input.a.b.c.value ?? null;
+        }
+      }
+    }
+  }
+  return null;
+}
